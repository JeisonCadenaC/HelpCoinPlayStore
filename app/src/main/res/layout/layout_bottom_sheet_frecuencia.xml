<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurface"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/montserrat_bold"
        android:text="Frecuencia de copia"
        android:textColor="?attr/colorOnSurface"
        android:textSize="20sp"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/montserrat_regular"
        android:text="Elige cada cuánto quieres que tus datos se guarden automáticamente en Google Drive."
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="14sp"
        android:layout_marginBottom="16dp"/>

    <RadioGroup
        android:id="@+id/rgFrecuencia"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/rbNunca"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserrat_medium"
            android:paddingVertical="12dp"
            android:text="Nunca"
            android:textColor="?attr/colorOnSurface"
            android:textSize="16sp"/>

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/rbDiariamente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserrat_medium"
            android:paddingVertical="12dp"
            android:text="Diariamente"
            android:textColor="?attr/colorOnSurface"
            android:textSize="16sp"/>

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/rbSemanalmente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserrat_medium"
            android:paddingVertical="12dp"
            android:text="Semanalmente"
            android:textColor="?attr/colorOnSurface"
            android:textSize="16sp"/>

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/rbMensualmente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserrat_medium"
            android:paddingVertical="12dp"
            android:text="Mensualmente"
            android:textColor="?attr/colorOnSurface"
            android:textSize="16sp"/>
    </RadioGroup>

</LinearLayout>