<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.motion.widget.MotionLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ui.home.InicioFragment"
    tools:ignore="MissingMotionLayoutLayoutDescription">

    <!-- HEADER -->
    <LinearLayout
        android:id="@+id/headerSection"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_margin="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:alpha="1">

        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/help_coin_logo"
            android:contentDescription="@string/app_name" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/txtHolaNombre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¡HOLA, BIENVENIDO!"
                android:textColor="@color/black"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtSubtitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tu resumen financiero del día"
                android:textColor="@color/dark_gray"
                android:textSize="13sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- NOTIFICACIÓN -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardNotificacion"
        android:layout_width="0dp"
        android:layout_height="90dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="8dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="5dp"
        app:cardBackgroundColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/headerSection"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:alpha="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/txtNotificacion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PRÓXIMO PAGO DE SERVICIOS PÚBLICOS"
                android:textColor="@color/gray"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PARA 25/11/2025"
                android:textColor="@color/purple_700"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- MENÚ PRINCIPAL -->
    <androidx.gridlayout.widget.GridLayout
        android:id="@+id/gridOpciones"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="20dp"
        app:rowCount="2"
        app:columnCount="3"
        app:layout_constraintTop_toBottomOf="@id/cardNotificacion"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:alpha="1">

        <!-- CARD CALENDARIO -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardCalendario"
            style="@style/HomeButtonCard"
            app:layout_rowWeight="1"
            app:layout_columnWeight="1">

            <LinearLayout style="@style/HomeCardContent">
                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:src="@drawable/ic_calendar"
                    app:tint="@color/purple_500" />
                <TextView
                    android:text="CALENDARIO"
                    style="@style/HomeCardText" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- CARD CRÉDITOS -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardCreditos"
            style="@style/HomeButtonCard"
            app:layout_rowWeight="1"
            app:layout_columnWeight="1">

            <LinearLayout style="@style/HomeCardContent">
                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:src="@drawable/ic_credit_card"
                    app:tint="@color/purple_500" />
                <TextView
                    android:text="CRÉDITOS"
                    style="@style/HomeCardText" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- CARD AHORROS -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAhorros"
            style="@style/HomeButtonCard"
            app:layout_rowWeight="1"
            app:layout_columnWeight="1">

            <LinearLayout style="@style/HomeCardContent">
                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:src="@drawable/ic_savings"
                    app:tint="@color/purple_500" />
                <TextView
                    android:text="AHORROS"
                    style="@style/HomeCardText" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- CARD FILTRO -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardFiltroCompras"
            style="@style/HomeButtonCard"
            app:layout_rowWeight="1"
            app:layout_columnWeight="1">

            <LinearLayout style="@style/HomeCardContent">
                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:src="@drawable/ic_tag"
                    app:tint="@color/purple_500" />
                <TextView
                    android:text="FILTRO"
                    style="@style/HomeCardText" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- CARD CONSEJOS -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardConsejos"
            style="@style/HomeButtonCard"
            app:layout_rowWeight="1"
            app:layout_columnWeight="1">

            <LinearLayout style="@style/HomeCardContent">
                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:src="@drawable/ic_rocket"
                    app:tint="@color/purple_500" />
                <TextView
                    android:text="CONSEJOS"
                    style="@style/HomeCardText" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </androidx.gridlayout.widget.GridLayout>

</androidx.constraintlayout.motion.widget.MotionLayout>