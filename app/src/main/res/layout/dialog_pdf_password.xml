<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="28dp"
    app:cardElevation="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <ImageView
            android:id="@+id/ivLockIcon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ic_visibility_off"
            app:tint="?attr/colorPrimary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvPasswordTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="PDF Protegido"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnBackground"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivLockIcon" />

        <TextView
            android:id="@+id/tvPasswordSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Este extracto está encriptado por seguridad. Ingresa la contraseña (usualmente tu número de cédula)."
            android:textSize="14sp"
            android:textAlignment="center"
            android:textColor="?attr/colorControlNormal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvPasswordTitle" />

        <EditText
            android:id="@+id/etPdfPassword"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/edittext_rounded"
            android:hint="Cédula o Contraseña"
            android:inputType="number|textNoSuggestions"
            android:importantForAutofill="noExcludeDescendants"
            android:autofillHints=""
            android:paddingHorizontal="16dp"
            android:textColor="?attr/colorOnBackground"
            android:textColorHint="?attr/colorControlNormal"
            android:textAlignment="center"
            android:letterSpacing="0.2"
            app:layout_constraintTop_toBottomOf="@id/tvPasswordSubtitle" />

        <Button
            android:id="@+id/btnCancelarPassword"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:layout_marginEnd="8dp"
            android:text="Cancelar"
            android:textColor="#FFFFFF"
            app:backgroundTint="#D32F2F"
            app:cornerRadius="16dp"
            app:layout_constraintEnd_toStartOf="@id/btnDesbloquearPdf"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/etPdfPassword" />

        <Button
            android:id="@+id/btnDesbloquearPdf"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:layout_marginStart="8dp"
            android:text="Desbloquear"
            app:cornerRadius="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnCancelarPassword"
            app:layout_constraintTop_toBottomOf="@id/etPdfPassword" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>